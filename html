<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enslaved African Americans in the 13 Colonies (1585–1776)</title>
  <style>
    :root {
      --bg-dark: #0b1322;
      --bg-panel: #152033;
      --bg-card: #1e2c44;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-primary: #34d399;
      --accent-colonial: #f59e0b;
      --accent-site: #f43f5e;
      --border-color: #2d3e59;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    header {
      background: linear-gradient(180deg, #070d17 0%, var(--bg-dark) 100%);
      padding: 0.85rem 1.4rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.85rem;
    }

    .title-group h1 {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #f8fafc;
    }

    .title-group p {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.15rem;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      font-size: 0.78rem;
      background: var(--bg-panel);
      padding: 0.45rem 0.8rem;
      border-radius: 8px;
      border: 1px solid var(--border-color);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      display: inline-block;
    }

    .dot.african {
      background-color: var(--accent-primary);
      box-shadow: 0 0 8px var(--accent-primary);
    }

    .dot.colonial {
      background-color: rgba(245, 158, 11, 0.75);
      border: 1px solid #fbbf24;
      border-radius: 3px;
    }

    .dot.event {
      background-color: var(--accent-site);
      box-shadow: 0 0 8px var(--accent-site);
    }

    main {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 330px;
      min-height: 0;
    }

    @media (max-width: 960px) {
      main {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .map-stage {
      position: relative;
      display: flex;
      flex-direction: column;
      background: #0a1628;
      border-right: 1px solid var(--border-color);
      min-height: 620px;
    }

    .canvas-container {
      position: relative;
      flex: 0 0 auto;
      width: 100%;
      height: clamp(600px, 82vh, 850px);
      min-height: 600px;
      overflow: hidden;
    }

    canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      cursor: crosshair;
    }

    .year-overlay {
      position: absolute;
      top: 1rem;
      left: 1.15rem;
      pointer-events: none;
      background: rgba(11, 19, 34, 0.82);
      backdrop-filter: blur(4px);
      padding: 0.6rem 0.9rem;
      border-radius: 8px;
      border: 1px solid rgba(51, 65, 85, 0.75);
    }

    .year-display {
      font-size: 2.75rem;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.04em;
      color: #f8fafc;
    }

    .era-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent-primary);
      margin-top: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .map-toggles {
      position: absolute;
      bottom: 0.85rem;
      left: 1.15rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      z-index: 10;
    }

    .toggle-pill {
      background: rgba(21, 32, 51, 0.92);
      border: 1px solid #334155;
      color: #cbd5e1;
      font-size: 0.75rem;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.15s;
    }

    .toggle-pill.active {
      background: rgba(52, 211, 153, 0.18);
      border-color: #34d399;
      color: #f8fafc;
      font-weight: 600;
    }

    .tooltip {
      position: absolute;
      background: rgba(11, 19, 34, 0.96);
      border: 1px solid #475569;
      border-radius: 8px;
      padding: 0.7rem 0.9rem;
      font-size: 0.8rem;
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, -115%);
      transition: opacity 0.15s ease;
      z-index: 25;
      min-width: 215px;
      max-width: 275px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
    }

    .tooltip h4 {
      color: #f8fafc;
      font-size: 0.88rem;
      margin-bottom: 0.3rem;
      border-bottom: 1px solid #334155;
      padding-bottom: 0.25rem;
    }

    .tooltip p {
      color: #cbd5e1;
      margin: 0.2rem 0;
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .tooltip span.val {
      font-weight: 600;
      color: #fff;
    }

    .timeline-controls {
      background: var(--bg-panel);
      border-top: 1px solid var(--border-color);
      padding: 0.9rem 1.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .controls-top {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    button.ctrl-btn {
      background: #283852;
      color: #f8fafc;
      border: 1px solid #475569;
      padding: 0.48rem 0.9rem;
      border-radius: 6px;
      font-size: 0.83rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: background 0.15s;
    }

    button.ctrl-btn:hover {
      background: #364b6e;
    }

    button.ctrl-btn.primary {
      background: #059669;
      border-color: #34d399;
    }

    button.ctrl-btn.primary:hover {
      background: #047857;
    }

    .slider-wrap {
      flex: 1;
      min-width: 200px;
      display: flex;
      flex-direction: column;
    }

    input[type="range"] {
      width: 100%;
      accent-color: var(--accent-primary);
      cursor: pointer;
      height: 6px;
    }

    .milestones {
      display: flex;
      justify-content: space-between;
      margin-top: 0.35rem;
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .milestone-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.73rem;
      padding: 2px 5px;
      border-radius: 4px;
    }

    .milestone-btn:hover, .milestone-btn.active {
      color: var(--accent-primary);
      background: rgba(52, 211, 153, 0.14);
      font-weight: 600;
    }

    .sidebar {
      background: var(--bg-panel);
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      overflow-y: auto;
    }

    .stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
    }

    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.75rem;
    }

    .stat-card .label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }

    .stat-card .value {
      font-size: 1.25rem;
      font-weight: 700;
      margin-top: 0.18rem;
    }

    .stat-card .sub {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 0.16rem;
    }

    .val-afr { color: var(--accent-primary); }
    .val-col { color: var(--accent-colonial); }

    .narrative-box {
      background: var(--bg-card);
      border-left: 3px solid var(--accent-primary);
      border-radius: 0 8px 8px 0;
      padding: 0.85rem;
    }

    .narrative-box h3 {
      font-size: 0.9rem;
      margin-bottom: 0.32rem;
      color: #f8fafc;
    }

    .narrative-box p {
      font-size: 0.79rem;
      line-height: 1.46;
      color: #cbd5e1;
    }

    .region-bars {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.8rem;
    }

    .region-bars h4 {
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }

    .bar-row {
      margin-bottom: 0.55rem;
    }

    .bar-row:last-child {
      margin-bottom: 0;
    }

    .bar-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      margin-bottom: 0.2rem;
    }

    .bar-track {
      height: 6px;
      background: #0b1322;
      border-radius: 4px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #059669, #34d399);
      border-radius: 4px;
      transition: width 0.2s ease;
    }

    .methodology-note {
      font-size: 0.7rem;
      color: var(--text-muted);
      line-height: 1.4;
      border-top: 1px solid var(--border-color);
      padding-top: 0.65rem;
    }
  
    main {grid-template-columns: minmax(0,1fr) 330px;}
    .map-stage {min-width:0;}
    .canvas-container {flex:1 1 0; min-height: max(620px, 76vh);}
    canvas {position:absolute; inset:0; touch-action:none; cursor:grab;}
    canvas.dragging {cursor:grabbing;}
    .view-controls {display:flex; flex-wrap:wrap; gap:6px; padding:8px; background:var(--bg-panel); border-bottom:1px solid var(--border-color);}
    .view-controls button {padding:6px 10px;}
    main.hide-stats {grid-template-columns:minmax(0,1fr);}
    main.hide-stats .sidebar {display:none;}
    .map-stage:fullscreen, .map-stage.expanded {display:flex; width:100%; height:100%; min-height:0; background:#0a1628; overflow:auto;}
    .map-stage.expanded {position:fixed; inset:0; z-index:1000;}
    .map-stage:fullscreen .canvas-container, .map-stage.expanded .canvas-container {min-height:240px;}
    .milestones {flex-wrap:wrap;}
    @media(max-width:960px){main {grid-template-columns:minmax(0,1fr);}}
    </style>
</head>
<body>
  <header>
    <div class="title-group">
      <h1>Enslaved African Americans in the 13 Colonies (1585–1776)</h1>
      <p>History of enslavement across the Atlantic coast • Population figures include both enslaved and free Black residents.</p>
    </div>
    <div class="legend">
      <div class="legend-item">
        <span class="dot african"></span>
        <span>Black Population (Enslaved &amp; Free; Dashed = 1776 Max)</span>
      </div>
      <div class="legend-item">
        <span class="dot colonial"></span>
        <span>13 Colonies Borders &amp; Established Territory</span>
      </div>
      <div class="legend-item">
        <span class="dot event"></span>
        <span>Key Historical Arrival / Port Site</span>
      </div>
    </div>
  </header>

  <main>
    <section class="map-stage">
      <div class="view-controls" aria-label="Map navigation">
        <button class="ctrl-btn" id="zoomIn" aria-label="Zoom in">＋ Zoom in</button>
        <button class="ctrl-btn" id="zoomOut" aria-label="Zoom out">− Zoom out</button>
        <button class="ctrl-btn" id="resetView">↺ Reset map view</button>
        <button class="ctrl-btn" id="fullView">⛶ Full screen</button>
        <button class="ctrl-btn" id="statsView" aria-expanded="true">Hide statistics</button>
        <span id="zoomStatus" style="align-self:center;font-size:.8rem" aria-live="polite">100% · Drag to move</span>
      </div>
      <div class="canvas-container" id="canvasContainer">
        <canvas id="mapCanvas"></canvas>
        <div class="year-overlay">
          <div class="year-display" id="yearDisplay">1585</div>
          <div class="era-label" id="eraLabel">Roanoke Expedition &amp; Early Arrivals</div>
        </div>
        <div class="map-toggles">
          <button class="toggle-pill active" id="toggleBordersBtn">✓ 13 Colonies Borders</button>
          <button class="toggle-pill active" id="toggleLabelsBtn">✓ Colony Names</button>
          <button class="toggle-pill active" id="toggleSitesBtn">✓ Historic Sites</button>
        </div>
        <div class="tooltip" id="tooltip"></div>
      </div>

      <div class="timeline-controls">
        <div class="controls-top">
          <button class="ctrl-btn primary" id="playPauseBtn">▶ Play Time-Lapse</button>
          <button class="ctrl-btn" id="resetBtn">↺ Reset (1585)</button>
          <button class="ctrl-btn" id="speedBtn">Speed: 1x</button>
          <div class="slider-wrap">
            <input type="range" id="yearSlider" min="1585" max="1776" value="1585" step="1" />
            <div class="milestones">
              <button class="milestone-btn active" data-year="1585">1585 Roanoke</button>
              <button class="milestone-btn" data-year="1619">1619 Point Comfort</button>
              <button class="milestone-btn" data-year="1670">1670 Charles Town</button>
              <button class="milestone-btn" data-year="1710">1710 SC Majority</button>
              <button class="milestone-btn" data-year="1750">1750 20% Share</button>
              <button class="milestone-btn" data-year="1776">1776 Independence</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside class="sidebar">
      <div class="stat-grid">
        <div class="stat-card">
          <div class="label">Black Population (Enslaved &amp; Free)</div>
          <div class="value val-afr" id="statAfrTotal">0</div>
          <div class="sub" id="statAfrSub">Pre-1586 Drake arrival at Roanoke</div>
        </div>
        <div class="stat-card">
          <div class="label">Share of Total Colonial Pop.</div>
          <div class="value val-afr" id="statSharePct">0.0%</div>
          <div class="sub" id="statShareSub">Enslaved &amp; free combined</div>
        </div>
        <div class="stat-card">
          <div class="label">Total 13 Colonies Pop.</div>
          <div class="value val-col" id="statTotalCol">~110</div>
          <div class="sub" id="statColSub">All colonial inhabitants</div>
        </div>
        <div class="stat-card">
          <div class="label">Largest Regional Share</div>
          <div class="value val-afr" id="statTopRegion">—</div>
          <div class="sub" id="statTopRegionSub">Awaiting permanent colonies</div>
        </div>
      </div>

      <div class="narrative-box">
        <h3 id="eraTitle">1585–1618: Roanoke Island &amp; Earliest Arrivals</h3>
        <p id="eraDesc">
          In 1585, English settlers landed on Roanoke Island. The following year (1586), Sir Francis Drake arrived at Roanoke carrying hundreds of enslaved Africans and freedmen taken from Spanish Caribbean ports, leaving an unknown number behind when the colonists departed. Permanent English settlements had not yet taken root.
        </p>
      </div>

      <div class="region-bars">
        <h4>Black Population by Region (Enslaved &amp; Free)</h4>
        <div id="regionBarsContainer"></div>
      </div>

      <div class="methodology-note">
        <strong>Historical Data Note:</strong> Boundaries are schematic approximations. The original population figures are combined totals, not enslaved-only counts. The original map attributes these figures to U.S. Census Bureau <em>Historical Statistics of the United States (Series Z 1–19)</em> estimates for enslaved and free Black residents across the 13 colonies (1620–1776). Hover over any colony or regional circle for local details.
      </div>
    </aside>
  </main>

  <script>
    const canvas = document.getElementById('mapCanvas');
    const ctx = canvas.getContext('2d');
    const container = document.getElementById('canvasContainer');
    const tooltip = document.getElementById('tooltip');

    const yearSlider = document.getElementById('yearSlider');
    const yearDisplay = document.getElementById('yearDisplay');
    const eraLabel = document.getElementById('eraLabel');
    const playPauseBtn = document.getElementById('playPauseBtn');
    const resetBtn = document.getElementById('resetBtn');
    const speedBtn = document.getElementById('speedBtn');

    let currentYear = 1585;
    let isPlaying = false;
    let speedMultiplier = 1;
    let lastFrameTime = 0;
    let hoveredItem = null;

    let showBorders = true;
    let showLabels = true;
    let showSites = true;

    document.getElementById('toggleBordersBtn').addEventListener('click', (e) => {
      showBorders = !showBorders;
      e.target.classList.toggle('active', showBorders);
      e.target.textContent = (showBorders ? '✓ ' : '✕ ') + '13 Colonies Borders';
      drawMap();
    });

    document.getElementById('toggleLabelsBtn').addEventListener('click', (e) => {
      showLabels = !showLabels;
      e.target.classList.toggle('active', showLabels);
      e.target.textContent = (showLabels ? '✓ ' : '✕ ') + 'Colony Names';
      drawMap();
    });

    document.getElementById('toggleSitesBtn').addEventListener('click', (e) => {
      showSites = !showSites;
      e.target.classList.toggle('active', showSites);
      e.target.textContent = (showSites ? '✓ ' : '✕ ') + 'Historic Sites';
      drawMap();
    });

    // Exact Eastern Seaboard Geographic Framing matching the Indigenous Population Map
    const GEO = {
      minLon: -86.5,
      maxLon: -65.2,
      minLat: 24.0,
      maxLat: 48.0
    };

    function project(lon, lat, bounds) {
      const xNorm = (lon - GEO.minLon) / (GEO.maxLon - GEO.minLon);
      const latRad = (lat * Math.PI) / 180;
      const minLatRad = (GEO.minLat * Math.PI) / 180;
      const maxLatRad = (GEO.maxLat * Math.PI) / 180;
      const mercY = Math.log(Math.tan(Math.PI / 4 + latRad / 2));
      const minMercY = Math.log(Math.tan(Math.PI / 4 + minLatRad / 2));
      const maxMercY = Math.log(Math.tan(Math.PI / 4 + maxLatRad / 2));
      const yNorm = 1 - (mercY - minMercY) / (maxMercY - minMercY);

      return [
        bounds.offsetX + xNorm * bounds.mapW,
        bounds.offsetY + yNorm * bounds.mapH
      ];
    }

    let zoom = 1, panX = 0, panY = 0;
    function getMapBounds(w, h) {
      const merc = lat => Math.log(Math.tan(Math.PI / 4 + lat * Math.PI / 360));
      const targetAspect = ((GEO.maxLon - GEO.minLon) * Math.PI / 180) / (merc(GEO.maxLat) - merc(GEO.minLat));
      let mapW = Math.max(1, w - 32);
      let mapH = Math.max(1, h - 145);
      if (mapW / mapH > targetAspect) {
        mapW = mapH * targetAspect;
      } else {
        mapH = mapW / targetAspect;
      }
      return {
        mapW: mapW * zoom,
        mapH: mapH * zoom,
        offsetX: (w - mapW * zoom) / 2 + panX,
        offsetY: 85 + (h - 145 - mapH * zoom) / 2 + panY
      };
    }

    // Surrounding North American Landmass (Canada, Midwest, Florida)
    const surroundingLandmass = [
      [
        [-84.0, 47.4], [-65.2, 47.4], [-65.2, 44.5], [-67.1, 45.1], [-69.2, 47.4],
        [-71.5, 45.0], [-74.8, 45.0], [-76.2, 44.1], [-79.1, 43.3], [-82.5, 42.3],
        [-83.5, 46.0], [-84.0, 47.4]
      ],
      [
        [-86.5, 47.4], [-84.0, 47.4], [-83.5, 46.0], [-82.5, 42.3], [-79.1, 43.3],
        [-79.8, 42.0], [-80.5, 39.7], [-81.9, 38.9], [-82.6, 37.5], [-84.2, 36.0],
        [-85.5, 35.0], [-86.5, 30.3], [-86.5, 47.4]
      ],
      [
        [-86.5, 30.3], [-85.0, 30.8], [-82.0, 30.4], [-81.4, 30.7], [-81.0, 29.0],
        [-80.5, 27.8], [-80.1, 26.0], [-80.4, 25.2], [-81.1, 25.1], [-81.7, 26.0],
        [-82.7, 27.8], [-82.8, 28.8], [-83.7, 29.8], [-84.9, 29.7], [-85.5, 30.0], [-86.5, 30.3]
      ]
    ];

    // Great Lakes Polygons
    const greatLakesGeo = [
      [[-84.6, 46.2], [-80.0, 45.2], [-82.4, 43.0], [-83.8, 44.0]],
      [[-83.4, 41.7], [-78.9, 42.9], [-79.2, 42.2], [-82.8, 41.4]],
      [[-79.7, 43.3], [-76.1, 44.1], [-76.3, 43.5], [-79.4, 43.2]]
    ];

    // All 13 Original Colonies with Detailed Eastern Seaboard Coastlines, Distinct Borders, and 1776 African American Population Estimates
    const thirteenColonies = [
      {
        id: 'NH',
        name: 'New Hampshire',
        shortName: 'New Hampshire',
        founded: 1623,
        afr1776: 650,
        pct1776: '~0.8%',
        labelPos: [-71.65, 43.75],
        notes: 'Small enslaved and free Black community concentrated mainly in Portsmouth (~650 by 1776, under 1% of colony).',
        coords: [
          [-71.5, 45.0], [-71.0, 45.2], [-70.7, 43.1], [-71.2, 42.7],
          [-72.5, 42.7], [-72.3, 43.6], [-71.5, 45.0]
        ]
      },
      {
        id: 'MA',
        name: 'Massachusetts (incl. Maine)',
        shortName: 'Massachusetts',
        founded: 1620,
        afr1776: 5250,
        pct1776: '~1.6%',
        labelPos: [-72.35, 42.38],
        secondLabelPos: [-69.1, 45.35],
        secondLabelText: 'MA (Maine)',
        notes: 'First Africans documented in Boston in 1638; ~5,250 Black residents by 1776 working in maritime trades, households, and farms.',
        coords: [
          [-73.5, 42.7], [-71.2, 42.7], [-70.8, 42.8], [-71.05, 42.35], [-70.65, 41.95],
          [-70.0, 41.7], [-70.05, 42.05], [-70.3, 41.7], [-70.9, 41.5], [-71.4, 42.0],
          [-73.5, 42.0], [-73.5, 42.7]
        ],
        extraCoords: [
          [-71.0, 45.2], [-69.2, 47.2], [-67.8, 47.0], [-67.0, 44.9], [-68.1, 44.4],
          [-68.9, 44.0], [-69.8, 43.8], [-70.25, 43.6], [-70.7, 43.1], [-71.0, 45.2]
        ]
      },
