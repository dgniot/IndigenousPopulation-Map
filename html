    function interpolateValue(anchors, year) {
      const years = Object.keys(anchors).map(Number).sort((a, b) => a - b);
      if (year <= years[0]) return anchors[years[0]];
      if (year >= years[years.length - 1]) return anchors[years[years.length - 1]];
      for (let i = 0; i < years.length - 1; i++) {
        const y1 = years[i];
        const y2 = years[i + 1];
        if (year >= y1 && year <= y2) {
          const t = (year - y1) / (y2 - y1);
          return Math.round(anchors[y1] + t * (anchors[y2] - anchors[y1]));
        }
      }
      return anchors[years[0]];
    }

    function formatNum(n) {
      return n.toLocaleString('en-US');
    }

    function pointInPolygon(x, y, polyCoords, bounds) {
      let inside = false;
      for (let i = 0, j = polyCoords.length - 1; i < polyCoords.length; j = i++) {
        const [xi, yi] = project(polyCoords[i][0], polyCoords[i][1], bounds);
        const [xj, yj] = project(polyCoords[j][0], polyCoords[j][1], bounds);
        const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi + 1e-9) + xi);
        if (intersect) inside = !inside;
      }
      return inside;
    }

    function drawTextWithHalo(text, x, y, font, fillStyle, align = 'center') {
      ctx.font = font;
      ctx.textAlign = align;
      ctx.lineJoin = 'round';
      ctx.lineWidth = 3.2;
      ctx.strokeStyle = 'rgba(9, 19, 34, 0.88)';
      ctx.strokeText(text, x, y);
      ctx.fillStyle = fillStyle;
      ctx.fillText(text, x, y);
    }

    function resizeCanvas() {
      const rect = container.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      drawMap();
    }

    function drawPolygon(coords, bounds, fillStyle, strokeStyle, lineWidth = 1.2, lineDash = []) {
      ctx.beginPath();
      coords.forEach(([lon, lat], idx) => {
        const [px, py] = project(lon, lat, bounds);
        if (idx === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.closePath();
      if (fillStyle) {
        ctx.fillStyle = fillStyle;
        ctx.fill();
      }
      if (strokeStyle) {
        ctx.setLineDash(lineDash);
        ctx.strokeStyle = strokeStyle;
        ctx.lineWidth = lineWidth;
        ctx.stroke();
        ctx.setLineDash([]);
      }
    }

    function drawMap() {
      const w = container.clientWidth;
      const h = container.clientHeight;
      const bounds = getMapBounds(w, h);

      // Ocean background gradient
      const oceanGrad = ctx.createLinearGradient(0, 0, w, h);
      oceanGrad.addColorStop(0, '#091526');
      oceanGrad.addColorStop(1, '#0d213d');
      ctx.fillStyle = oceanGrad;
      ctx.fillRect(0, 0, w, h);

      // Subtle Latitude/Longitude Graticule Lines
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.08)';
      ctx.lineWidth = 1;
      for (let lon = -85; lon <= -65; lon += 5) {
        const [x1, y1] = project(lon, GEO.minLat, bounds);
        const [x2, y2] = project(lon, GEO.maxLat, bounds);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }
      for (let lat = 30; lat <= 45; lat += 5) {
        const [x1, y1] = project(GEO.minLon, lat, bounds);
        const [x2, y2] = project(GEO.maxLon, lat, bounds);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }

      // Draw Surrounding North American Landmass
      surroundingLandmass.forEach(poly => {
        drawPolygon(poly, bounds, '#162338', '#263854', 1.2);
      });

      // Draw Great Lakes
      greatLakesGeo.forEach(lake => {
        drawPolygon(lake, bounds, '#0a182b', '#273c5c', 1.1);
      });

      // Draw Each of the 13 Colonies
      thirteenColonies.forEach(colony => {
        const isEstablished = currentYear >= colony.founded;
        const isHovered = hoveredItem && hoveredItem.type === 'colony' && hoveredItem.data.id === colony.id;

        let fillColor = '#1c2b44';
        if (isEstablished) {
          const yearsActive = currentYear - colony.founded;
          const intensity = Math.min(1, 0.20 + Math.sqrt(yearsActive / 170) * 0.42);
          fillColor = isHovered
            ? `rgba(251, 191, 36, ${Math.min(0.85, intensity + 0.2)})`
            : `rgba(217, 119, 6, ${intensity.toFixed(2)})`;
        } else if (isHovered) {
          fillColor = 'rgba(52, 211, 153, 0.22)';
        }

        const borderColor = showBorders
          ? (isEstablished ? (isHovered ? '#fde68a' : 'rgba(251, 191, 36, 0.82)') : 'rgba(148, 163, 184, 0.38)')
          : 'rgba(148, 163, 184, 0.15)';
        const borderDash = showBorders ? (isEstablished ? [] : [3, 3]) : [];
        const borderWidth = isHovered ? 2.4 : (isEstablished ? 1.5 : 1);

        drawPolygon(colony.coords, bounds, fillColor, borderColor, borderWidth, borderDash);
        if (colony.extraCoords) {
          drawPolygon(colony.extraCoords, bounds, fillColor, borderColor, borderWidth, borderDash);
        }
      });

      // Draw Regional African American Population Bubbles (with 1776 Max Ghost Rings)
      const scaleFactor = Math.min(bounds.mapW, bounds.mapH) / 520;
      regions.forEach(reg => {
        const currentPop = interpolateValue(reg.pop, currentYear);
        const maxPop1776 = reg.pop[1776];
        const [cx, cy] = project(reg.lon, reg.lat, bounds);

        const r = currentPop > 0 ? Math.max(6, Math.sqrt(currentPop / 420) * 2.15 * scaleFactor) : 0;
        const maxR = Math.max(7, Math.sqrt(maxPop1776 / 420) * 2.15 * scaleFactor);

        reg._screenX = cx;
        reg._screenY = cy;
        reg._screenR = Math.max(r, 14);
        reg._currentPop = currentPop;

        const isHovered = hoveredItem && hoveredItem.type === 'region' && hoveredItem.data.id === reg.id;

        // 1776 Peak Reference Dashed Ghost Ring
        ctx.beginPath();
        ctx.arc(cx, cy, maxR, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(52, 211, 153, 0.32)';
        ctx.setLineDash([3, 3]);
        ctx.lineWidth = 1.1;
        ctx.stroke();
        ctx.setLineDash([]);

        if (currentPop > 0) {
          const grad = ctx.createRadialGradient(cx, cy, 1, cx, cy, r);
          grad.addColorStop(0, 'rgba(52, 211, 153, 0.94)');
          grad.addColorStop(1, 'rgba(5, 150, 105, 0.50)');

          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();

          ctx.strokeStyle = isHovered ? '#ffffff' : '#6ee7b7';
          ctx.lineWidth = isHovered ? 2.5 : 1.4;
          ctx.stroke();
        }

        // Compact Population Count Label
        drawTextWithHalo(
          formatNum(currentPop),
          cx,
          cy + Math.max(r, 8) + 12,
          '700 11px sans-serif',
          currentPop > 0 ? '#d1fae5' : '#94a3b8',
          'center'
        );
      });

      // Draw Colony Labels on Top with Leader Lines for Small Coastal Colonies
      if (showLabels) {
        thirteenColonies.forEach(colony => {
          const isEstablished = currentYear >= colony.founded;
          const [lx, ly] = project(colony.labelPos[0], colony.labelPos[1], bounds);
          const font = isEstablished ? '700 11.5px sans-serif' : '600 10.5px sans-serif';
          const color = isEstablished ? '#fef3c7' : '#cbd5e1';

          if (colony.leaderFrom) {
            const [fx, fy] = project(colony.leaderFrom[0], colony.leaderFrom[1], bounds);
            ctx.beginPath();
            ctx.moveTo(fx, fy);
            ctx.lineTo(lx - 4, ly - 3);
            ctx.strokeStyle = isEstablished ? 'rgba(253, 230, 138, 0.7)' : 'rgba(148, 163, 184, 0.55)';
            ctx.lineWidth = 1.1;
            ctx.stroke();
            drawTextWithHalo(colony.shortName || colony.name, lx, ly, font, color, 'left');
          } else {
            drawTextWithHalo(colony.shortName || colony.name, lx, ly, font, color, 'center');
          }

          if (colony.secondLabelPos) {
            const [lx2, ly2] = project(colony.secondLabelPos[0], colony.secondLabelPos[1], bounds);
            drawTextWithHalo(colony.secondLabelText, lx2, ly2, font, color, 'center');
          }
        });
      }

      // Draw Historic Coastal Arrival / Port Sites
      if (showSites) {
        historicSites.forEach(site => {
          if (currentYear >= site.year) {
            const [sx, sy] = project(site.lon, site.lat, bounds);
            const isKeySite = site.year === 1586 || site.year === 1619;

            ctx.beginPath();
            ctx.arc(sx, sy, isKeySite ? 5 : 4, 0, Math.PI * 2);
            ctx.fillStyle = isKeySite ? '#f43f5e' : '#fef08a';
            ctx.fill();
            ctx.strokeStyle = '#0f172a';
            ctx.lineWidth = 1.3;
            ctx.stroke();

            drawTextWithHalo(
              site.name,
              sx + 8,
              sy + 4,
              isKeySite ? '700 11px sans-serif' : '600 10.5px sans-serif',
              isKeySite ? '#fda4af' : '#fef9c3',
              'left'
            );
          }
        });
      }

      if (showLabels) {
        const [flx, fly] = project(-81.6, 27.1, bounds);
        drawTextWithHalo(currentYear >= 1763 ? "British Florida" : "Spanish Florida", flx, fly, "600 10px sans-serif", "#cbd5e1");
      }

      // Ocean Title Watermark
      ctx.fillStyle = 'rgba(148, 163, 184, 0.24)';
      ctx.font = 'italic 700 14px Georgia, serif';
      ctx.textAlign = 'center';
      const [ax, ay] = project(-69.5, 33.2, bounds);
      ctx.fillText('ATLANTIC OCEAN', ax, ay);
    }

    function updateDashboard() {
      yearDisplay.textContent = currentYear;
      yearSlider.value = currentYear;

      const activeEra = eras.find(e => currentYear >= e.min && currentYear <= e.max) || eras[0];
      eraLabel.textContent = activeEra.label;
      document.getElementById('eraTitle').textContent = activeEra.title;
      document.getElementById('eraDesc').textContent = activeEra.desc;

      document.querySelectorAll('.milestone-btn').forEach(btn => {
        const y = Number(btn.dataset.year);
        btn.classList.toggle('active', Math.abs(currentYear - y) <= 4);
      });

      let totalAfrNow = 0;
      let topReg = regions[0];
      let topRegVal = -1;

      regions.forEach(reg => {
        const val = interpolateValue(reg.pop, currentYear);
        totalAfrNow += val;
        if (val > topRegVal) {
          topRegVal = val;
          topReg = reg;
        }
      });

      const totalColNow = interpolateValue(totalColonialPopAnchors, currentYear);
      const sharePct = totalColNow > 0 ? ((totalAfrNow / totalColNow) * 100).toFixed(1) : '0.0';

      document.getElementById('statAfrTotal').textContent =
        currentYear < 1619 ? (currentYear >= 1586 ? 'Roanoke (1586)' : '0') : '~' + formatNum(totalAfrNow);
      document.getElementById('statAfrSub').textContent =
        currentYear < 1586 ? 'Before 1586 Drake arrival' :
        currentYear < 1619 ? 'Unrecorded after 1586 departure' : '13 Colonies total (enslaved & free)';

      document.getElementById('statSharePct').textContent =
        currentYear < 1619 ? '—' : `${sharePct}%`;
      document.getElementById('statShareSub').textContent =
        currentYear < 1619 ? 'No permanent census yet' : 'Of all colonial inhabitants';

      document.getElementById('statTotalCol').textContent = '~' + formatNum(totalColNow);
      document.getElementById('statColSub').textContent =
        currentYear < 1607 ? 'Roanoke expedition outposts' : 'Total 13 Colonies population';

      if (totalAfrNow === 0) {
        document.getElementById('statTopRegion').textContent = '—';
        document.getElementById('statTopRegionSub').textContent = 'Starts at Point Comfort (1619)';
      } else {
        const regShare = Math.round((topRegVal / totalAfrNow) * 100);
        document.getElementById('statTopRegion').textContent = topReg.name.split(' (')[0];
        document.getElementById('statTopRegionSub').textContent = `~${formatNum(topRegVal)} (${regShare}% of Black pop.)`;
      }

      const barsContainer = document.getElementById('regionBarsContainer');
      barsContainer.innerHTML = '';
      regions.forEach(reg => {
        const now = interpolateValue(reg.pop, currentYear);
        const pctOfMax = Math.round((now / reg.pop[1776]) * 100);
        const row = document.createElement('div');
        row.className = 'bar-row';
        row.innerHTML = `
          <div class="bar-header">
            <span>${reg.name.split(' (')[0]}</span>
            <span>${formatNum(now)}</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill" style="width: ${pctOfMax}%;"></div>
          </div>
        `;
        barsContainer.appendChild(row);
      });

      drawMap();
    }

    function animate(timestamp) {
      if (!isPlaying) return;
      if (timestamp - lastFrameTime > (140 / speedMultiplier)) {
        lastFrameTime = timestamp;
        if (currentYear < 1776) {
          currentYear++;
          updateDashboard();
        } else {
          isPlaying = false;
          playPauseBtn.textContent = '▶ Replay Time-Lapse';
        }
      }
      requestAnimationFrame(animate);
    }

    playPauseBtn.addEventListener('click', () => {
      if (currentYear >= 1776) currentYear = 1585;
      isPlaying = !isPlaying;
      playPauseBtn.textContent = isPlaying ? '❚❚ Pause' : '▶ Play Time-Lapse';
      if (isPlaying) {
        lastFrameTime = performance.now();
        requestAnimationFrame(animate);
      }
    });

    resetBtn.addEventListener('click', () => {
      isPlaying = false;
      playPauseBtn.textContent = '▶ Play Time-Lapse';
      currentYear = 1585;
      updateDashboard();
    });

    speedBtn.addEventListener('click', () => {
      speedMultiplier = speedMultiplier === 1 ? 2 : speedMultiplier === 2 ? 4 : 1;
      speedBtn.textContent = `Speed: ${speedMultiplier}x`;
    });

    yearSlider.addEventListener('input', (e) => {
      currentYear = Number(e.target.value);
      updateDashboard();
    });

    document.querySelectorAll('.milestone-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        isPlaying = false;
        playPauseBtn.textContent = '▶ Play Time-Lapse';
        currentYear = Number(btn.dataset.year);
        updateDashboard();
      });
    });

    function handlePointer(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      const mx = clientX - rect.left;
      const my = clientY - rect.top;
      const bounds = getMapBounds(rect.width, rect.height);

      for (const reg of regions) {
        const dx = mx - reg._screenX;
        const dy = my - reg._screenY;
        if (Math.hypot(dx, dy) <= reg._screenR) {
          hoveredItem = { type: 'region', data: reg };
          tooltip.innerHTML = `
            <h4>${reg.name}</h4>
            <p><span>${currentYear} Est.:</span> <span class="val">~${formatNum(reg._currentPop)}</span></p>
            <p><span>1776 Est.:</span> <span class="val">~${formatNum(reg.pop[1776])}</span></p>
            <p style="margin-top:0.35rem; font-size:0.74rem; color:#94a3b8; display:block;">${reg.notes}</p>
          `;
          tooltip.style.left = `${Math.min(rect.width - 140, Math.max(140, mx))}px`;
          tooltip.style.top = `${Math.max(105, my - 10)}px`;
          tooltip.style.opacity = '1';
          drawMap();
          return;
        }
      }

      for (const col of thirteenColonies) {
        const inMain = pointInPolygon(mx, my, col.coords, bounds);
        const inExtra = col.extraCoords ? pointInPolygon(mx, my, col.extraCoords, bounds) : false;
        if (inMain || inExtra) {
          hoveredItem = { type: 'colony', data: col };
          const isEst = currentYear >= col.founded;
          const estAfrPop = isEst
            ? Math.round(col.afr1776 * Math.pow((currentYear - col.founded + 1) / (1776 - col.founded + 1), 1.75))
            : 0;
          tooltip.innerHTML = `
            <h4>Colony of ${col.name}</h4>
            <p><span>Status (${currentYear}):</span> <span class="val">${isEst ? 'Established' : 'Not Yet Founded'}</span></p>
            <p><span>${currentYear} Black Pop.:</span> <span class="val">${isEst ? '~' + formatNum(estAfrPop) : '0'}</span></p>
            <p><span>1776 Share:</span> <span class="val">${col.pct1776} (~${formatNum(col.afr1776)})</span></p>
            <p style="margin-top:0.35rem; font-size:0.74rem; color:#94a3b8; display:block;">${col.notes}</p>
          `;
          tooltip.style.left = `${Math.min(rect.width - 140, Math.max(140, mx))}px`;
          tooltip.style.top = `${Math.max(105, my - 10)}px`;
          tooltip.style.opacity = '1';
          drawMap();
          return;
        }
      }

      hoveredItem = null;
      tooltip.style.opacity = '0';
      drawMap();
    }

    const stage = document.querySelector('.map-stage');
    const main = document.querySelector('main');
    const fullButton = document.getElementById('fullView');
    const statsButton = document.getElementById('statsView');
    function refreshView() {
      hoveredItem = null; tooltip.style.opacity = '0';
      document.getElementById('zoomStatus').textContent = Math.round(zoom * 100) + '% · Drag to move';
      document.getElementById('zoomIn').disabled = zoom >= 5;
      document.getElementById('zoomOut').disabled = zoom <= 1;
      drawMap();
    }
    function changeZoom(factor) {
      const next = Math.max(1, Math.min(5, zoom * factor));
      panX *= next / zoom; panY *= next / zoom; zoom = next;
      if (zoom === 1) {panX = 0; panY = 0;}
      refreshView();
    }
    document.getElementById('zoomIn').onclick = () => changeZoom(1.25);
    document.getElementById('zoomOut').onclick = () => changeZoom(0.8);
    document.getElementById('resetView').onclick = () => {zoom = 1; panX = panY = 0; refreshView();};
    statsButton.onclick = () => {
      const hidden = main.classList.toggle('hide-stats');
      statsButton.textContent = hidden ? 'Show statistics' : 'Hide statistics';
      statsButton.setAttribute('aria-expanded', String(!hidden));
      requestAnimationFrame(resizeCanvas);
    };
    function syncFull() {
      fullButton.textContent = document.fullscreenElement === stage || stage.classList.contains('expanded') ? 'Exit full screen' : '⛶ Full screen';
      requestAnimationFrame(resizeCanvas);
    }
    fullButton.onclick = async () => {
      if (document.fullscreenElement === stage) await document.exitFullscreen();
      else if (stage.classList.contains('expanded')) stage.classList.remove('expanded');
      else {try {if (!stage.requestFullscreen) throw Error(); await stage.requestFullscreen();} catch {stage.classList.add('expanded');}}
      syncFull();
    };
    document.addEventListener('fullscreenchange', syncFull);
    document.addEventListener('keydown', e => {if(e.key === 'Escape' && stage.classList.contains('expanded')) {stage.classList.remove('expanded'); syncFull();}});
    let drag = null;
    canvas.addEventListener('pointerdown', e => {
      if (e.button !== 0) return;
      drag = {id:e.pointerId,x:e.clientX,y:e.clientY,moved:false};
      canvas.setPointerCapture(e.pointerId); canvas.classList.add('dragging');
    });
    canvas.addEventListener('pointermove', e => {
      if (drag && drag.id === e.pointerId) {
        const dx=e.clientX-drag.x, dy=e.clientY-drag.y;
        if(dx || dy) {drag.moved=true; panX+=dx; panY+=dy; drag.x=e.clientX; drag.y=e.clientY; refreshView();}
      } else if(e.pointerType==='mouse') handlePointer(e.clientX,e.clientY);
    });
    function endDrag(e) {
      if(!drag || drag.id!==e.pointerId) return;
      const moved=drag.moved; drag=null; canvas.classList.remove('dragging');
      if(!moved && e.type==='pointerup') handlePointer(e.clientX,e.clientY);
    }
    canvas.addEventListener('pointerup',endDrag);
    canvas.addEventListener('pointercancel',endDrag);
    canvas.addEventListener('lostpointercapture',endDrag);
    canvas.addEventListener('pointerleave', () => {if(!drag){hoveredItem=null; tooltip.style.opacity='0'; drawMap();}});
    refreshView();

    window.addEventListener('resize', resizeCanvas);
    if (window.ResizeObserver) new ResizeObserver(resizeCanvas).observe(container);
    resizeCanvas();
    updateDashboard();
  </script>
</body>
</html>